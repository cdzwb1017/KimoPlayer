{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiomPlayer",
  "version": "1.5.1",
  "identifier": "com.kiomosu.kiomplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KiomPlayer",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "name": "KiomPlayer Audio",
        "ext": ["mp3", "flac", "wav", "ogg", "m4a", "aac", "wma", "opus", "ape", "aiff"],
        "description": "Audio File"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

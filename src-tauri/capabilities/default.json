{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "opener:default",
    "dialog:default"
  ]
}
